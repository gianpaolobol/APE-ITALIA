{
  "name": "ape-italia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @ape/mobile",
    "web": "npm run dev -w @ape/web",
    "api": "npm run start:dev -w @ape/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "next@15.5.29": {
      "postcss": "8.5.23"
    },
    "@expo/metro-config@54.0.17": {
      "postcss": "8.5.23",
      "glob": "14.0.2"
    },
    "@prisma/config@6.19.3": {
      "effect": "3.22.1",
      "deepmerge-ts": "8.0.0"
    },
    "metro@0.83.3": {
      "image-size": "2.0.3"
    },
    "@nestjs/cli@11.0.24": {
      "glob": "14.0.2"
    },
    "@expo/cli@54.0.28": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    },
    "@expo/config-plugins@54.0.6": {
      "glob": "14.0.2"
    },
    "@expo/config@12.0.14": {
      "glob": "14.0.2"
    },
    "@expo/fingerprint@0.15.5": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    },
    "glob@14.0.2": {
      "minimatch": "11.0.1"
    }
  }
}
