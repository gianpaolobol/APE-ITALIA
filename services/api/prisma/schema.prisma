generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum CaseStatus {
 DRAFT
 SUBMITTED
 AWAITING_EVIDENCE
 ASSIGNED
 INSPECTION_SCHEDULED
 INSPECTION_DONE
 UNDER_REVIEW
 DEPOSITED
 DELIVERED
 CANCELLED
}
model Organization {
 id String @id @default(uuid())
 name String
 properties Property[]
 cases ApeCase[]
 memberships Membership[]
 invitations Invitation[]
 createdAt DateTime @default(now())
}
model Property {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 address String
 city String
 region String
 floorAreaM2 Float?
 cases ApeCase[]
 createdAt DateTime @default(now())
 @@index([organizationId])
}
model ApeCase {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 propertyId String
 property Property @relation(fields: [propertyId], references: [id])
 status CaseStatus @default(DRAFT)
 evidence Evidence[]
 consents Consent[]
 assignments Assignment[]
 extractedFields ExtractedField[]
 inspections Inspection[]
 certificate Certificate?
 evidenceRequests EvidenceRequest[]
 /// Guided survey from the app (answers, indicative estimate, quote). Not an APE.
 survey Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,status])
}
/// Uploaded file metadata. Content lives encrypted in private object storage under storageKey.
model Evidence {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 organizationId String
 kind String
 storageKey String @unique
 mimeType String
 sizeBytes Int
 sha256 String
 uploadedBy String
 scanStatus String @default("unscanned")
 /// AI pre-survey of a walkthrough video (draft for the certifier, never a measurement).
 analysis Json?
 createdAt DateTime @default(now())
 extractedFields ExtractedField[]
 @@unique([caseId, sha256])
 @@index([caseId])
 @@index([organizationId])
}

/// Record of a data subject's acceptance of a versioned notice, scoped to a case.
model Consent {
 id String @id @default(uuid())
 organizationId String
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 subject String
 kind String
 version String
 acceptedAt DateTime @default(now())
 @@unique([caseId, subject, kind, version])
 @@index([organizationId])
}
model AuditEvent {
 id String @id @default(uuid())
 organizationId String
 actorId String
 action String
 resourceId String
 occurredAt DateTime @default(now())
 @@index([organizationId,occurredAt])
}

model Membership {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 userSubject String
 role String @default("member")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([organizationId,userSubject])
 @@index([userSubject])
}

/// One-time invitation: only the SHA-256 hash of the code is stored; the code is shown once to the issuer.
model Invitation {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 codeHash String @unique
 role String
 createdBy String
 expiresAt DateTime
 acceptedBy String?
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([organizationId])
}

/// Platform-level professional profile. Verification against the regional register is a human operator step.
model Certifier {
 id String @id @default(uuid())
 userSubject String @unique
 displayName String
 registrationId String
 regions String[]
 /// Provinces (BO, MO, ...) the certifier serves; empty = whole region.
 provinces String[] @default([])
 maxActiveAssignments Int @default(5)
 active Boolean @default(true)
 verifiedAt DateTime?
 verifiedBy String?
 createdAt DateTime @default(now())
 assignments Assignment[]
}

enum AssignmentStatus {
 OFFERED
 ACCEPTED
 DECLINED
 EXPIRED
 WITHDRAWN
}

/// Offer of a case to a certifier. A certifier is never offered the same case twice.
model Assignment {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 certifierId String
 certifier Certifier @relation(fields: [certifierId], references: [id])
 organizationId String
 status AssignmentStatus @default(OFFERED)
 offeredAt DateTime @default(now())
 expiresAt DateTime
 respondedAt DateTime?
 declineReason String?
 /// Optional pre-inspection video call (never a substitute for the mandatory on-site inspection).
 callAt DateTime?
 callUrl String?
 inspection Inspection?
 @@unique([caseId, certifierId])
 @@index([certifierId, status])
 @@index([caseId])
}

enum InspectionStatus {
 SCHEDULED
 DONE
 CANCELLED
}

/// On-site inspection by the accepted certifier. The report is immutable once submitted.
model Inspection {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 assignmentId String @unique
 assignment Assignment @relation(fields: [assignmentId], references: [id])
 organizationId String
 status InspectionStatus @default(SCHEDULED)
 scheduledAt DateTime
 performedAt DateTime?
 report Json?
 reportSubmittedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([caseId])
 @@index([organizationId])
}

/// Machine-extracted candidate value. Never authoritative: a certifier must accept, correct or reject it.
model ExtractedField {
 id String @id @default(uuid())
 organizationId String
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 evidenceId String
 evidence Evidence @relation(fields: [evidenceId], references: [id])
 field String
 value Json
 unit String?
 confidence Float?
 status String @default("needs_review")
 modelId String
 extractedAt DateTime @default(now())
 reviewedBy String?
 reviewedAt DateTime?
 revisions ExtractedFieldRevision[]
 @@unique([evidenceId, field, modelId])
 @@index([caseId])
 @@index([organizationId])
}

/// Append-only history of every extraction and human review decision.
model ExtractedFieldRevision {
 id String @id @default(uuid())
 extractedFieldId String
 extractedField ExtractedField @relation(fields: [extractedFieldId], references: [id])
 action String
 previousValue Json?
 newValue Json?
 actor String
 note String?
 at DateTime @default(now())
 @@index([extractedFieldId])
}

/// The official APE as produced, signed and deposited by the certifier in the regional system.
/// The platform only stores and delivers it; it never generates certificate content.
model Certificate {
 id String @id @default(uuid())
 caseId String @unique
 case ApeCase @relation(fields: [caseId], references: [id])
 organizationId String
 certifierId String
 storageKey String @unique
 sha256 String
 sizeBytes Int
 scanStatus String @default("unscanned")
 regionalId String
 depositedAt DateTime
 /// Official energy class declared by the certifier (as in the deposited APE).
 energyClass String?
 validUntil DateTime?
 uploadedAt DateTime @default(now())
 deliveredAt DateTime?
 deliveredTo String?
 @@index([organizationId])
}

/// Request from the certifier for additional documents or photos ("richiesta di integrazione").
model EvidenceRequest {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 organizationId String
 assignmentId String
 message String
 kinds String[]
 previousStatus CaseStatus
 createdBy String
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 resolvedBy String?
 @@index([caseId])
 @@index([organizationId])
}

/// Shared rate-limit counters (fixed window per key) so that several API instances enforce one limit.
model RateLimitBucket {
 key String @id
 hits Int
 expiresAt DateTime
 blockedUntil DateTime?
 @@index([expiresAt])
}

enum ApplicationStatus {
 PENDING
 APPROVED
 REJECTED
}

/// Self-service application of an energy certifier. Activation requires an operator to check the SACE
/// accreditation number on the public Emilia-Romagna list (registerVerifiedCertifier records who did it).
model CertifierApplication {
 id                 String            @id @default(uuid())
 firstName          String
 lastName           String
 email              String            @unique
 phone              String
 pec                String?
 vatNumber          String
 taxCode            String
 profession         String
 professionalOrder  String
 orderNumber        String
 region             String
 saceNumber         String            @unique
 provinces          String[]
 status             ApplicationStatus @default(PENDING)
 createdAt          DateTime          @default(now())
 reviewedAt         DateTime?
 reviewedBy         String?
 reviewNote         String?
}

/// Customer/certifier account authenticated by a one-time code sent by email (no password).
model PlatformUser {
 id        String    @id @default(uuid())
 email     String?   @unique
 createdAt DateTime  @default(now())
 lastLoginAt DateTime?
 deletedAt DateTime?
 pushTokens String[]
 refreshTokens RefreshToken[]
}

model LoginCode {
 id         String   @id @default(uuid())
 email      String
 codeHash   String
 expiresAt  DateTime
 attempts   Int      @default(0)
 consumedAt DateTime?
 createdAt  DateTime @default(now())
 @@index([email, createdAt])
}

model RefreshToken {
 id        String   @id @default(uuid())
 userId    String
 user      PlatformUser @relation(fields: [userId], references: [id])
 tokenHash String   @unique
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId])
}

/// Resumable upload of a large evidence file (walkthrough video) in numbered parts.
model ChunkedUpload {
 id             String   @id @default(uuid())
 caseId         String
 organizationId String
 kind           String
 totalBytes     Int
 partSize       Int
 receivedParts  Int[]
 createdBy      String
 createdAt      DateTime @default(now())
 completedAt    DateTime?
 evidenceId     String?
 @@index([caseId])
}

enum PaymentStatus {
 PENDING
 PAID
 CANCELLED
}

/// Customer payment for a case (Stripe Checkout). Amount recomputed server-side from the survey.
model Payment {
 id              String        @id @default(uuid())
 caseId          String
 organizationId  String
 amountCents     Int
 currency        String        @default("eur")
 status          PaymentStatus @default(PENDING)
 stripeSessionId String?       @unique
 createdBy       String
 createdAt       DateTime      @default(now())
 paidAt          DateTime?
 @@index([caseId])
}
