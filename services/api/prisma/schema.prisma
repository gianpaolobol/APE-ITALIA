generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum CaseStatus {
 DRAFT
 SUBMITTED
 AWAITING_EVIDENCE
 ASSIGNED
 INSPECTION_SCHEDULED
 INSPECTION_DONE
 UNDER_REVIEW
 DEPOSITED
 DELIVERED
 CANCELLED
}
model Organization {
 id String @id @default(uuid())
 name String
 properties Property[]
 cases ApeCase[]
 memberships Membership[]
 invitations Invitation[]
 createdAt DateTime @default(now())
}
model Property {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 address String
 city String
 region String
 floorAreaM2 Float?
 cases ApeCase[]
 createdAt DateTime @default(now())
 @@index([organizationId])
}
model ApeCase {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 propertyId String
 property Property @relation(fields: [propertyId], references: [id])
 status CaseStatus @default(DRAFT)
 evidence Evidence[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,status])
}
model Evidence {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 kind String
 storageKey String
 createdAt DateTime @default(now())
 @@index([caseId])
}
model AuditEvent {
 id String @id @default(uuid())
 organizationId String
 actorId String
 action String
 resourceId String
 occurredAt DateTime @default(now())
 @@index([organizationId,occurredAt])
}

model Membership {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 userSubject String
 role String @default("member")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([organizationId,userSubject])
 @@index([userSubject])
}

/// One-time invitation: only the SHA-256 hash of the code is stored; the code is shown once to the issuer.
model Invitation {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 codeHash String @unique
 role String
 createdBy String
 expiresAt DateTime
 acceptedBy String?
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([organizationId])
}
