generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum CaseStatus {
 DRAFT
 SUBMITTED
 AWAITING_EVIDENCE
 ASSIGNED
 INSPECTION_SCHEDULED
 INSPECTION_DONE
 UNDER_REVIEW
 DEPOSITED
 DELIVERED
 CANCELLED
}
model Organization {
 id String @id @default(uuid())
 name String
 properties Property[]
 cases ApeCase[]
 memberships Membership[]
 invitations Invitation[]
 createdAt DateTime @default(now())
}
model Property {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 address String
 city String
 region String
 floorAreaM2 Float?
 cases ApeCase[]
 createdAt DateTime @default(now())
 @@index([organizationId])
}
model ApeCase {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 propertyId String
 property Property @relation(fields: [propertyId], references: [id])
 status CaseStatus @default(DRAFT)
 evidence Evidence[]
 consents Consent[]
 assignments Assignment[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,status])
}
/// Uploaded file metadata. Content lives encrypted in private object storage under storageKey.
model Evidence {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 organizationId String
 kind String
 storageKey String @unique
 mimeType String
 sizeBytes Int
 sha256 String
 uploadedBy String
 scanStatus String @default("unscanned")
 createdAt DateTime @default(now())
 @@unique([caseId, sha256])
 @@index([caseId])
 @@index([organizationId])
}

/// Record of a data subject's acceptance of a versioned notice, scoped to a case.
model Consent {
 id String @id @default(uuid())
 organizationId String
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 subject String
 kind String
 version String
 acceptedAt DateTime @default(now())
 @@unique([caseId, subject, kind, version])
 @@index([organizationId])
}
model AuditEvent {
 id String @id @default(uuid())
 organizationId String
 actorId String
 action String
 resourceId String
 occurredAt DateTime @default(now())
 @@index([organizationId,occurredAt])
}

model Membership {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 userSubject String
 role String @default("member")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([organizationId,userSubject])
 @@index([userSubject])
}

/// One-time invitation: only the SHA-256 hash of the code is stored; the code is shown once to the issuer.
model Invitation {
 id String @id @default(uuid())
 organizationId String
 organization Organization @relation(fields: [organizationId], references: [id])
 codeHash String @unique
 role String
 createdBy String
 expiresAt DateTime
 acceptedBy String?
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([organizationId])
}

/// Platform-level professional profile. Verification against the regional register is a human operator step.
model Certifier {
 id String @id @default(uuid())
 userSubject String @unique
 displayName String
 registrationId String
 regions String[]
 maxActiveAssignments Int @default(5)
 active Boolean @default(true)
 verifiedAt DateTime?
 verifiedBy String?
 createdAt DateTime @default(now())
 assignments Assignment[]
}

enum AssignmentStatus {
 OFFERED
 ACCEPTED
 DECLINED
 EXPIRED
 WITHDRAWN
}

/// Offer of a case to a certifier. A certifier is never offered the same case twice.
model Assignment {
 id String @id @default(uuid())
 caseId String
 case ApeCase @relation(fields: [caseId], references: [id])
 certifierId String
 certifier Certifier @relation(fields: [certifierId], references: [id])
 organizationId String
 status AssignmentStatus @default(OFFERED)
 offeredAt DateTime @default(now())
 expiresAt DateTime
 respondedAt DateTime?
 declineReason String?
 @@unique([caseId, certifierId])
 @@index([certifierId, status])
 @@index([caseId])
}
