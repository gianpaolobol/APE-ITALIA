DATABASE_URL="postgresql://ape:local_dev_only@localhost:5432/ape_italia?schema=public"
PORT=3001
# Never commit actual credentials. Local development only.
OIDC_ISSUER="https://your-auth-provider.example/"
OIDC_AUDIENCE="ape-italia-api"
OIDC_JWKS_URL="https://your-auth-provider.example/.well-known/jwks.json"
# Private evidence storage (encrypted at rest, AES-256-GCM). Generate the key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in a secret manager; losing it makes stored evidence unreadable.
EVIDENCE_STORAGE_DIR="/var/lib/ape-italia/evidence"
EVIDENCE_ENCRYPTION_KEY=""
# Development only: allow downloading files not yet malware-scanned. Never enable in production.
EVIDENCE_ALLOW_UNSCANNED="0"
