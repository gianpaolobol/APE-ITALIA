{
  "expo": {
    "name": "APE Italia",
    "slug": "ape-italia",
    "scheme": "apeitalia",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.apeitalia.app",
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "package": "it.apeitalia.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D5B4A"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "APE Italia usa la fotocamera per fotografare caldaia, targhette, serramenti e impianti della pratica.",
          "photosPermission": "APE Italia accede alle foto che scegli per allegarle alla pratica.",
          "microphonePermission": "La fotocamera di iOS chiede il microfono per registrare il video dell’immobile: l’audio non viene conservato da APE Italia."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-web-browser",
      "./plugins/withPrivateAndroidBackup"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F2"
  }
}
