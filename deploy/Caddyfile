# API behind TLS. API_DOMAIN must point (DNS A/AAAA record) to this host before the first start.
{$API_DOMAIN} {
	encode gzip
	request_body {
		max_size 320MB
	}
	reverse_proxy api:3001
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Dedicated web origin: keep cookies and API traffic on separate hosts.
# The compose default is a container-local HTTP listener for synthetic CI only.
{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
