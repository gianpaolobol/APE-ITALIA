# Copy to deploy/.env on the host (never commit it). Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POSTGRES_PASSWORD=
EVIDENCE_ENCRYPTION_KEY=
WEB_SESSION_KEY=
OIDC_ISSUER=https://
OIDC_JWKS_URL=https://
OIDC_AUDIENCE=ape-italia-api
WEB_OIDC_CLIENT_ID=
WEB_OIDC_CLIENT_SECRET=
WEB_BASE_URL=https://
API_BASE_URL=https://
TRUST_PROXY=1
RETENTION_APPLY=0
# Public API domain (Caddy issues the TLS certificate automatically) and its URL
API_DOMAIN=api.example.it
PUBLIC_API_URL=https://api.example.it
# Email-code login (>= 32 random chars) and outgoing mail (Brevo)
PLATFORM_JWT_SECRET=
MAILER=brevo
BREVO_API_KEY=
MAIL_FROM=no-reply@example.it
# Optional: AI reading of photos/videos (requires DPA and consent in the app)
SURVEY_PHOTO_READER=
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=
# Optional: payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
